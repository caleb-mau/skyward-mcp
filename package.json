{
  "name": "skyward-mcp",
  "version": "0.1.0",
  "description": "Unofficial self hosted Skyward MCP for students and educators",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:stdio": "tsx src/index.ts",
    "build": "next build",
