# Required for hosted MCP mode.
# ChatGPT uses the built in OAuth flow and asks for this secret once.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Optional canonical public deployment origin.
MCP_PUBLIC_ORIGIN=

# Preferred hosted authentication option when you already have a Skyward session.
# This is base64 transport encoding of a SkywardSessionExport. It is not encryption.
SKYWARD_SESSION_B64=

# JSON form is also supported, but base64 is easier to paste into deployment UIs.
SKYWARD_SESSION_JSON=

# Optional local or server session file path.
# Local setup defaults to ~/.skyward-mcp/session.json.
SKYWARD_SESSION_FILE=

# Classic SMS 2.0 fallback for districts that still allow native username/password login.
# These credentials are used only to create a Skyward session.
SKYWARD_LOGIN_URL=
SKYWARD_USERNAME=
SKYWARD_PASSWORD=

# Request timeout used by skyward-rest.
SKYWARD_TIMEOUT_MS=30000
